---
import { Image } from 'astro:assets';
import { ArrowRight, ArrowUpRight, Star, Waves, HeartPulse, Utensils, Mountain } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingBar from '../components/BookingBar.astro';
import Marquee from '../components/Marquee.astro';
import RoomCard from '../components/RoomCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FacilityGrid from '../components/FacilityGrid.astro';
import ReviewScores from '../components/ReviewScores.astro';
import PriceNote from '../components/PriceNote.astro';
import CTASection from '../components/CTASection.astro';
import { rooms } from '../data/rooms';
import { site } from '../data/site';
import { pool, procedures, water } from '../data/treatments';
import { nearby } from '../data/nearby';
import { score } from '../data/reviews';
import { photo } from '../lib/photos';
import { url } from '../lib/url';


const pillars = [
  { icon: HeartPulse, title: 'Bază de tratament proprie', text: 'Zece proceduri, în hotel, cu lift până la ușă.' },
  { icon: Waves, title: 'Apă termală de la sursă', text: 'Bazin acoperit de 30 mp, plus saună și fitness.' },
  { icon: Utensils, title: 'Restaurant propriu', text: 'Bucătărie tradițională, 40 de locuri și terasă.' },
  { icon: Mountain, title: 'Vedere la Domogled', text: 'Camerele dau spre munte și spre stațiune.' },
];
---

<BaseLayout image={photo('piscina/01')}>
  <!-- HERO -->
  <section class="relative flex min-h-[100svh] flex-col overflow-hidden bg-thermal-950 text-white" data-hero>
    <div class="absolute inset-0 overflow-hidden">
      <Image
        src={photo('piscina/01')}
        alt="Bazinul exterior al Hotelului Internațional, cu Munții Domogled în fundal"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="img-cover hero-zoom"
        style="object-position:center 42%"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-thermal-950/55 via-thermal-950/30 to-thermal-950/92"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-thermal-950/60 via-thermal-950/15 to-transparent"></div>
    </div>

    <div class="container-x relative flex flex-1 flex-col justify-end pb-10 pt-36 md:pb-14" data-hero-fade>
      <div class="flex items-center gap-3 text-[0.68rem] font-semibold uppercase tracking-[0.26em] text-white/85" data-reveal>
        <span class="flex gap-0.5 text-copper-300">
          {Array.from({ length: site.stars }).map(() => <Star size={12} fill="currentColor" stroke-width={0} />)}
        </span>
        Hotel de tratament · Băile Herculane
      </div>

      <h1 class="display-xl mt-6 max-w-[13ch]" data-split="hero">
        Hotel <em class="italic-serif text-copper-300">Internațional</em>
      </h1>

      <div class="mt-8 grid items-end gap-10 lg:grid-cols-12">
        <p class="max-w-lg text-lg leading-relaxed text-white/85 md:text-xl lg:col-span-6" data-reveal>
          Apă termo-sulfuroasă de la sursă, bază proprie de tratament și camere cu vedere la Munții Domogled —
          în mijlocul celei mai vechi stațiuni balneare din lume.
        </p>
        <div class="hidden items-center justify-end gap-6 lg:col-span-6 lg:flex" data-reveal>
          <div class="text-right">
            <p class="font-serif text-4xl leading-none">{score.value}</p>
            <p class="mt-1.5 text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-white/70">
              {score.label} · {score.count} evaluări
            </p>
          </div>
          <span class="h-12 w-px bg-white/25"></span>
          <div class="text-right">
            <p class="font-serif text-4xl leading-none">30 <span class="text-lg">mp</span></p>
            <p class="mt-1.5 text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-white/70">Bazin termal acoperit</p>
          </div>
        </div>
      </div>

      <div class="mt-10" data-reveal>
        <BookingBar />
      </div>

      <div class="mt-8 flex items-center justify-between text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-white/70">
        <a href="#despre" class="flex items-center gap-3">
          <span class="scroll-cue relative block h-10 w-px overflow-hidden bg-white/25"></span>
          Descoperiți
        </a>
        <span class="hidden items-center gap-3 sm:flex">
          Aleea Florilor 1A · Băile Herculane
        </span>
      </div>
    </div>
  </section>

  <!-- DESPRE -->
  <section id="despre" class="relative bg-travertine-100 pb-28 pt-28 md:pb-40 md:pt-40">
    <div class="container-x">
      <p class="eyebrow" data-reveal>Bine ați venit</p>
      <p
        class="mt-10 max-w-6xl font-serif text-[clamp(1.8rem,4.2vw,3.9rem)] leading-[1.14] tracking-[-0.015em] text-thermal-900"
        data-scrub-words
      >
        Ne dorim să fim oportunitatea oricărui turist, de oriunde, de a se trata, relaxa și odihni în hotelul nostru.
      </p>

      <div class="mt-24 grid items-center gap-16 md:mt-32 lg:grid-cols-12 lg:gap-10">
        <div class="relative lg:col-span-7">
          <div class="relative aspect-[4/5] overflow-hidden rounded-[1.75rem] md:aspect-[5/4]" data-reveal-img>
            <Image
              src={photo('exterior/02')}
              alt="Hotelul Internațional, văzut dinspre bazinul exterior"
              widths={[640, 1024, 1400]}
              sizes="(min-width: 1024px) 55vw, 100vw"
              class="img-cover"
            />
          </div>
          <div
            class="absolute -bottom-10 right-4 hidden w-[38%] overflow-hidden rounded-[1.25rem] border-[6px] border-travertine-100 shadow-2xl md:block lg:-right-10"
            data-reveal-img
            data-delay="0.2"
          >
            <div class="aspect-[3/4]">
              <Image
                src={photo('imprejurimi/01')}
                alt="Priveliștea spre Munții Domogled, de pe balcon"
                widths={[400, 700]}
                sizes="25vw"
                class="img-cover"
              />
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 lg:pl-10">
          <h2 class="display-md" data-split>
            Un hotel nou, în mijlocul unei stațiuni de <em class="italic-serif">două milenii</em>
          </h2>
          <p class="lead mt-8" data-reveal>
            Deschis în primăvara anului 2010, Hotel Internațional*** a fost gândit pentru cine vine în Băile Herculane
            pentru apa lui: bază de tratament proprie, bazin alimentat direct de la izvor și un personal care știe
            ce face.
          </p>
          <p class="mt-5 text-muted" data-reveal>
            Deși stă în mijlocul stațiunii, hotelul e aproape de natură și departe de aglomerație. A fost distins cu
            titlul „Cel mai Fashion Complex Turistic din Banat” la Fashion România Awards.
          </p>
          <a href={url('/imprejurimi')} class="arrow-link mt-10 text-thermal-800" data-reveal>
            Despre stațiune și împrejurimi <ArrowRight size={16} />
          </a>
        </div>
      </div>

      <!-- Cei patru piloni -->
      <ul class="mt-28 grid gap-px overflow-hidden rounded-[1.75rem] bg-thermal-900/10 sm:grid-cols-2 lg:grid-cols-4 md:mt-36">
        {
          pillars.map((p, i) => (
            <li class="bg-travertine-50 p-7 md:p-9" data-reveal data-delay={i * 0.06}>
              <p.icon size={26} stroke-width={1.3} class="text-copper-600" />
              <h3 class="mt-6 font-serif text-[1.35rem] leading-tight text-thermal-900">{p.title}</h3>
              <p class="mt-3 text-[0.92rem] leading-relaxed text-muted">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Marquee words={['Tratament', 'Apă termală', 'SPA', 'Domogled']} class="bg-thermal-900 text-travertine-50" />

  <!-- CAMERE -->
  <section class="bg-travertine-50 py-28 md:py-40">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <SectionHeading
          eyebrow="Cazare"
          title='Patru feluri de a sta la <em class="italic-serif">Internațional</em>'
          text="Descrierile și pozele sunt aici. Camerele libere și tarifele lor, pentru perioada dorită, le vedeți într-un singur clic, în programul de rezervări al hotelului."
        />
        <a href={url('/camere')} class="arrow-link mb-2 text-thermal-800" data-reveal>
          Toate camerele <ArrowRight size={16} />
        </a>
      </div>

      <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {rooms.map((room, i) => <RoomCard room={room} index={i} />)}
      </div>

      <PriceNote class="mt-16" />
    </div>
  </section>

  <!-- TRATAMENT -->
  <section class="relative overflow-hidden bg-thermal-900 py-28 text-travertine-50 md:py-40">
    <div class="container-x">
      <div class="grid gap-16 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <SectionHeading
            eyebrow="Bază de tratament"
            title='Apa care a făcut <em class="italic-serif">stațiunea</em>'
            text={`Apă ${water.type}, cu ${water.mineralisation} și ${water.note} — folosită în hotel atât în bazin, cât și în procedurile bazei de tratament.`}
            light
          />
          <ul class="mt-12 grid grid-cols-2 gap-x-6 gap-y-3 text-[0.95rem] text-travertine-100/80" data-reveal>
            {
              procedures.map((p) => (
                <li class="flex items-center gap-2.5">
                  <span class="h-1 w-1 shrink-0 rounded-full bg-copper-400" aria-hidden="true" />
                  {p}
                </li>
              ))
            }
          </ul>
          <a href={url('/tratament')} class="arrow-link mt-12 text-copper-300" data-reveal>
            Indicațiile de cură <ArrowRight size={16} />
          </a>
        </div>

        <div class="lg:col-span-7">
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="overflow-hidden rounded-[1.5rem] sm:mt-16" data-reveal-img>
              <div class="aspect-[3/4]">
                <Image
                  src={photo('tratament/01')}
                  alt="Ședință de electroterapie în baza de tratament a hotelului"
                  widths={[400, 700]}
                  sizes="(min-width: 1024px) 28vw, 50vw"
                  class="img-cover"
                />
              </div>
            </div>
            <div class="overflow-hidden rounded-[1.5rem]" data-reveal-img data-delay="0.15">
              <div class="aspect-[3/4]">
                <Image
                  src={photo('spa/01')}
                  alt="Duș subacval la centrul SPA"
                  widths={[400, 700]}
                  sizes="(min-width: 1024px) 28vw, 50vw"
                  class="img-cover"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BAZIN -->
  <section class="bg-travertine-100 py-28 md:py-40">
    <div class="container-x grid items-center gap-16 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <div class="overflow-hidden rounded-[1.75rem]" data-reveal-img>
          <div class="aspect-[16/10]">
            <Image
              src={photo('piscina/01')}
              alt="Bazinul exterior al hotelului, cu vedere spre munte"
              widths={[640, 1024, 1500]}
              sizes="(min-width: 1024px) 55vw, 100vw"
              class="img-cover"
              style="object-position:center 45%"
            />
          </div>
        </div>
      </div>
      <div class="lg:col-span-5 lg:pl-8">
        <SectionHeading
          eyebrow="Bazin și SPA"
          title='Treizeci de metri pătrați de <em class="italic-serif">apă termală</em>'
          size="md"
          text={pool.text}
        />
        <dl class="mt-12 grid grid-cols-2 gap-8" data-reveal>
          <div>
            <dt class="text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-muted">Suprafață</dt>
            <dd class="mt-2 font-serif text-4xl text-thermal-900">{pool.area} mp</dd>
          </div>
          <div>
            <dt class="text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-muted">Adâncime maximă</dt>
            <dd class="mt-2 font-serif text-4xl text-thermal-900">{pool.depth} m</dd>
          </div>
        </dl>
        <p class="mt-8 text-muted" data-reveal>
          Accesul la bazin, la saună (cu program) și la sala de fitness este gratuit pentru oaspeții hotelului.
        </p>
        <a href={url('/spa-si-piscina')} class="arrow-link mt-10 text-thermal-800" data-reveal>
          Serviciile centrului SPA <ArrowRight size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- RESTAURANT -->
  <section class="relative overflow-hidden bg-thermal-950 py-28 text-travertine-50 md:py-40">
    <div class="container-x grid items-center gap-16 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow="Restaurant"
          title='Rafinat, elegant și cu <em class="italic-serif">terasă</em>'
          size="md"
          text="Patruzeci de locuri, o gamă largă de preparate tradiționale românești pregătite la comandă, un bar de zi și o terasă frumos amenajată, pentru serile calde de vară."
          light
        />
        <a href={url('/restaurant')} class="arrow-link mt-10 text-copper-300" data-reveal>
          Despre restaurant și regimurile de masă <ArrowRight size={16} />
        </a>
      </div>
      <div class="lg:col-span-7">
        <div class="overflow-hidden rounded-[1.75rem]" data-reveal-img>
          <div class="aspect-[16/10]">
            <Image
              src={photo('restaurant/01')}
              alt="Sala restaurantului hotelului, cu mesele pregătite"
              widths={[640, 1024, 1500]}
              sizes="(min-width: 1024px) 55vw, 100vw"
              class="img-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FACILITĂȚI -->
  <section class="bg-travertine-50 py-28 md:py-40">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <SectionHeading eyebrow="Facilități" title="Tot ce găsiți sub același acoperiș" />
        <a href={url('/facilitati')} class="arrow-link mb-2 text-thermal-800" data-reveal>
          Lista completă <ArrowRight size={16} />
        </a>
      </div>
      <div class="mt-16">
        <FacilityGrid limit={8} />
      </div>
    </div>
  </section>

  <ReviewScores />

  <!-- ÎMPREJURIMI -->
  <section class="bg-travertine-100 py-28 md:py-40">
    <div class="container-x grid gap-16 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow="Împrejurimi"
          title='Stațiunea începe la <em class="italic-serif">poarta hotelului</em>'
          size="md"
          text="Parcul Vicol e la 150 de metri, ștrandul termal la 250, iar Parcul Național Domogled – Valea Cernei la trei kilometri și jumătate."
        />
        <a href={url('/imprejurimi')} class="arrow-link mt-10 text-thermal-800" data-reveal>
          Trasee și informații pentru turiști <ArrowRight size={16} />
        </a>
      </div>
      <div class="lg:col-span-7">
        <ul class="divide-y divide-thermal-900/10 border-y border-thermal-900/10">
          {
            nearby.map((n, i) => (
              <li class="flex items-baseline justify-between gap-6 py-5" data-reveal data-delay={i * 0.04}>
                <span class="font-serif text-[1.35rem] text-thermal-900">{n.name}</span>
                <span class="text-sm font-semibold uppercase tracking-[0.14em] text-copper-600">{n.dist}</span>
              </li>
            ))
          }
        </ul>
        <a
          href={url('/galerie')}
          class="mt-10 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-thermal-800"
          data-reveal
        >
          Vedeți galeria foto <ArrowUpRight size={16} />
        </a>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
