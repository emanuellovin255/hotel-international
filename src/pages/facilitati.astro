---
import { Image } from 'astro:assets';
import { Check } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FacilityGrid from '../components/FacilityGrid.astro';
import CTASection from '../components/CTASection.astro';
import { roomAmenities, conference } from '../data/facilities';
import { photo } from '../lib/photos';
---

<BaseLayout
  title="Servicii și facilități"
  description="Serviciile Hotelului Internațional din Băile Herculane: bazin termal, bază de tratament, SPA, saună, fitness, restaurant, sală de conferințe, parcare gratuită și lift."
  image={photo('exterior/02')}
>
  <PageHero
    eyebrow="Servicii"
    crumb="Facilități"
    title='Tot ce ține de un sejur, <em class="italic-serif">sub același acoperiș</em>'
    subtitle="Camere confortabile cu vedere panoramică spre stațiune, bază de tratament proprie, centru SPA și restaurant."
    image={photo('exterior/02')}
    alt="Hotelul Internațional văzut dinspre bazinul exterior"
  />

  <section class="bg-travertine-100 py-24 md:py-32">
    <div class="container-x">
      <SectionHeading eyebrow="Facilități" title="Lista completă" />
      <div class="mt-16">
        <FacilityGrid />
      </div>
    </div>
  </section>

  <!-- DOTĂRILE CAMERELOR -->
  <section class="bg-travertine-50 py-24 md:py-32">
    <div class="container-x">
      <SectionHeading
        eyebrow="În cameră"
        title="Dotările camerelor"
        text="Toate camerele au baie proprie, aer condiționat, încălzire, televizor și internet. Balconul sau terasa depind de tipul de cameră."
      />
      <div class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
        {
          roomAmenities.map((g, i) => (
            <div data-reveal data-delay={i * 0.06}>
              <h3 class="eyebrow font-sans">{g.group}</h3>
              <ul class="mt-6 space-y-2.5 text-[0.95rem] text-muted">
                {g.items.map((item) => (
                  <li class="flex gap-2.5">
                    <Check size={15} stroke-width={2} class="mt-1 shrink-0 text-copper-500" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SALA DE CONFERINȚE -->
  <section class="bg-thermal-900 py-24 text-travertine-50 md:py-32">
    <div class="container-x grid items-center gap-16 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-6">
        <div class="overflow-hidden rounded-[1.75rem]" data-reveal-img>
          <div class="aspect-[16/10]">
            <Image
              src={photo('conferinte/01')}
              alt="Sala de conferințe a hotelului, aranjată pentru o prezentare"
              widths={[640, 1024, 1400]}
              sizes="(min-width: 1024px) 48vw, 100vw"
              class="img-cover"
            />
          </div>
        </div>
      </div>
      <div class="lg:col-span-6 lg:pl-8">
        <SectionHeading
          eyebrow="Evenimente"
          title={`Sala de conferințe <em class="italic-serif">„Internațional”</em>`}
          size="md"
          text={conference.text}
          light
        />
        <div class="mt-12 grid gap-10 sm:grid-cols-2" data-reveal>
          <div>
            <h3 class="eyebrow eyebrow-light font-sans">Dotare</h3>
            <ul class="mt-5 space-y-2.5 text-[0.95rem] text-travertine-100/80">
              {
                conference.equipment.map((e) => (
                  <li class="flex gap-2.5">
                    <Check size={15} stroke-width={2} class="mt-1 shrink-0 text-copper-300" />
                    {e}
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h3 class="eyebrow eyebrow-light font-sans">La cerere</h3>
            <ul class="mt-5 space-y-2.5 text-[0.95rem] text-travertine-100/80">
              {
                conference.catering.map((c) => (
                  <li class="flex gap-2.5">
                    <Check size={15} stroke-width={2} class="mt-1 shrink-0 text-copper-300" />
                    {c}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <p class="mt-10 font-serif text-2xl text-copper-300" data-reveal>{conference.seats} de locuri</p>
      </div>
    </div>
  </section>

  <CTASection image={photo('conferinte/02')} />
</BaseLayout>
