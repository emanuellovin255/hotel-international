---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Gallery from '../components/Gallery.astro';
import type { GalleryItem } from '../components/Gallery.astro';
import CTASection from '../components/CTASection.astro';
import { photo, photos } from '../lib/photos';

const groups: { id: string; label: string; folder: string; alt: string }[] = [
  { id: 'exterior', label: 'Hotelul', folder: 'exterior', alt: 'Hotelul Internațional din Băile Herculane' },
  { id: 'camere', label: 'Camere', folder: '', alt: '' },
  { id: 'piscina', label: 'Bazin', folder: 'piscina', alt: 'Bazinul hotelului' },
  { id: 'spa', label: 'SPA și tratament', folder: '', alt: '' },
  { id: 'restaurant', label: 'Restaurant', folder: 'restaurant', alt: 'Restaurantul hotelului' },
  { id: 'imprejurimi', label: 'Împrejurimi', folder: 'imprejurimi', alt: 'Împrejurimile hotelului' },
];

const items: GalleryItem[] = [
  ...photos('exterior').map((src, i) => ({ src, alt: `Hotelul Internațional – ${i + 1}`, cat: 'exterior' })),
  ...['camere/dubla-balcon', 'camere/apartament-2-terase', 'camere/apartament-fara-terasa', 'camere/single'].flatMap(
    (folder) => photos(folder).map((src, i) => ({ src, alt: `Cameră la Hotel Internațional – ${i + 1}`, cat: 'camere' })),
  ),
  ...photos('piscina').map((src, i) => ({ src, alt: `Bazinul hotelului – ${i + 1}`, cat: 'piscina' })),
  ...photos('spa').map((src, i) => ({ src, alt: `Centrul SPA – ${i + 1}`, cat: 'spa' })),
  ...photos('tratament').map((src, i) => ({ src, alt: `Baza de tratament – ${i + 1}`, cat: 'spa' })),
  ...photos('restaurant').map((src, i) => ({ src, alt: `Restaurantul hotelului – ${i + 1}`, cat: 'restaurant' })),
  ...photos('conferinte').map((src, i) => ({ src, alt: `Sala de conferințe – ${i + 1}`, cat: 'restaurant' })),
  ...photos('receptie').map((src, i) => ({ src, alt: `Recepția hotelului – ${i + 1}`, cat: 'exterior' })),
  ...photos('imprejurimi').map((src, i) => ({ src, alt: `Împrejurimile hotelului – ${i + 1}`, cat: 'imprejurimi' })),
];

// Elimină duplicatele: aceeași poză poate apărea în mai multe camere.
const seen = new Set<string>();
const unique = items.filter((item) => {
  if (seen.has(item.src.src)) return false;
  seen.add(item.src.src);
  return true;
});

const filters = groups.map(({ id, label }) => ({ id, label }));
---

<BaseLayout
  title="Galerie foto"
  description="Fotografii de la Hotel Internațional*** din Băile Herculane: hotelul, camerele, bazinul termal, centrul SPA, restaurantul și împrejurimile."
  image={photo('exterior/02')}
>
  <PageHero
    eyebrow="Galerie"
    title='Hotelul, în <em class="italic-serif">fotografii</em>'
    subtitle="Camerele, bazinul termal, baza de tratament, restaurantul și priveliștea care se vede de pe balcoane."
    image={photo('imprejurimi/02')}
    alt="Vedere spre stațiune de pe balconul hotelului"
    position="center 40%"
  />

  <section class="bg-travertine-100 py-24 md:py-32">
    <div class="container-x">
      <Gallery items={unique} filters={filters} />
    </div>
  </section>

  <CTASection />
</BaseLayout>
