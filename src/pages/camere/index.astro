---
import { Building2 } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import RoomCard from '../../components/RoomCard.astro';
import PriceNote from '../../components/PriceNote.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import CTASection from '../../components/CTASection.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { rooms, wholeProperty } from '../../data/rooms';
import { roomAmenities } from '../../data/facilities';
import { photo } from '../../lib/photos';
---

<BaseLayout
  title="Camere și apartamente"
  description="Camere duble cu balcon, apartamente cu două terase și camere single la Hotel Internațional*** din Băile Herculane. Descrieri, dotări și fotografii."
  image={photo('camere/dubla-balcon/01')}
>
  <PageHero
    eyebrow="Cazare"
    crumb="Camere"
    title='Camere cu vedere spre <em class="italic-serif">munte</em>'
    subtitle="Fiecare cameră are baie proprie, aer condiționat, televizor și birou. Cele mai multe au și balcon sau terasă."
    image={photo('camere/dubla-balcon/02')}
    alt="Cameră cu fotoliu și ieșire spre balcon"
  />

  <section class="bg-travertine-100 py-24 md:py-32">
    <div class="container-x">
      <PriceNote />

      <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {rooms.map((room, i) => <RoomCard room={room} index={i} />)}
      </div>

      <!-- Toată unitatea -->
      <div
        class="mt-16 flex flex-col gap-7 rounded-[1.75rem] bg-thermal-900 p-8 text-travertine-50 md:p-12 lg:flex-row lg:items-center lg:justify-between"
        data-reveal
      >
        <div class="flex gap-5">
          <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-copper-400/40 text-copper-300">
            <Building2 size={24} stroke-width={1.3} />
          </span>
          <div>
            <h2 class="font-serif text-[1.75rem] leading-tight">{wholeProperty.name}</h2>
            <p class="mt-3 max-w-xl text-[0.95rem] leading-relaxed text-travertine-100/75">{wholeProperty.text}</p>
          </div>
        </div>
        <BookingCTA short class="shrink-0" />
      </div>
    </div>
  </section>

  <!-- DOTĂRI -->
  <section class="bg-travertine-50 py-24 md:py-32">
    <div class="container-x">
      <SectionHeading
        eyebrow="Dotări"
        title="Ce găsiți în cameră"
        text="Dotările de mai jos sunt comune tuturor camerelor. Diferențele dintre tipuri sunt trecute pe pagina fiecărei camere."
      />
      <div class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
        {
          roomAmenities.map((g, i) => (
            <div data-reveal data-delay={i * 0.06}>
              <h3 class="eyebrow font-sans">{g.group}</h3>
              <ul class="mt-6 space-y-2.5 text-[0.95rem] text-muted">
                {g.items.map((item) => (
                  <li class="flex gap-2.5">
                    <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-copper-400" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection image={photo('camere/apartament-2-terase/03')} position="center 55%" />
</BaseLayout>
