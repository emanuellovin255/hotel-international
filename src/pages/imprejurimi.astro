---
import { Image } from 'astro:assets';
import { Footprints, TrainFront, MapPin } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MapEmbed from '../components/MapEmbed.astro';
import CTASection from '../components/CTASection.astro';
import { nearby, transport, trails, resort } from '../data/nearby';
import { photo } from '../lib/photos';
---

<BaseLayout
  title="Împrejurimi"
  description="Băile Herculane, stațiunea de lângă Hotel Internațional: izvoarele termale, traseele turistice, Parcul Național Domogled – Valea Cernei și distanțele până la fiecare."
  image={photo('imprejurimi/01')}
>
  <PageHero
    eyebrow="Împrejurimi"
    title='Una dintre cele mai vechi stațiuni <em class="italic-serif">din lume</em>'
    subtitle="Aproape două milenii de istorie balneară, pe culoarul Cernei, între Munții Cernei și Munții Domogled."
    image={photo('imprejurimi/01')}
    alt="Vedere spre Munții Domogled, de pe balconul hotelului"
    position="center 45%"
  />

  <!-- STAȚIUNEA -->
  <section class="bg-travertine-100 py-24 md:py-32">
    <div class="container-x grid gap-16 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-6">
        <SectionHeading eyebrow="Stațiunea" title='Numele vine de la <em class="italic-serif">Hercules</em>' size="md" />
        <p class="lead mt-8" data-reveal>{resort.intro}</p>
        <p class="mt-6 text-muted" data-reveal>{resort.water}</p>
      </div>
      <div class="lg:col-span-6">
        <div class="overflow-hidden rounded-[1.75rem]" data-reveal-img>
          <div class="aspect-[4/3]">
            <Image
              src={photo('imprejurimi/02')}
              alt="Stațiunea Băile Herculane, văzută de pe balconul hotelului"
              widths={[640, 1024, 1400]}
              sizes="(min-width: 1024px) 48vw, 100vw"
              class="img-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRASEE -->
  <section class="bg-thermal-900 py-24 text-travertine-50 md:py-32">
    <div class="container-x">
      <SectionHeading
        eyebrow="Trasee turistice"
        title="Locuri cu o frumusețe încărcată de legendă"
        text="Zona oferă numeroase trasee turistice. Acestea patru sunt cele pe care le întreabă toată lumea la recepție."
        light
      />
      <ul class="mt-16 grid gap-px overflow-hidden rounded-[1.75rem] bg-travertine-100/10 sm:grid-cols-2 lg:grid-cols-4">
        {
          trails.map((t, i) => (
            <li class="bg-thermal-900 p-8 md:p-10" data-reveal data-delay={(i % 4) * 0.07}>
              <Footprints size={24} stroke-width={1.3} class="text-copper-300" />
              <h3 class="mt-7 font-serif text-[1.45rem] leading-tight">{t.name}</h3>
              <p class="mt-3 text-[0.93rem] leading-relaxed text-travertine-100/70">{t.text}</p>
            </li>
          ))
        }
      </ul>
      <div class="mt-16 overflow-hidden rounded-[1.75rem]" data-reveal-img>
        <div class="aspect-[21/9]">
          <Image
            src={photo('imprejurimi/03')}
            alt="Amfiteatrul din Băile Herculane, cu muntele în fundal"
            widths={[768, 1280, 1800]}
            sizes="100vw"
            class="img-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- DISTANȚE -->
  <section class="bg-travertine-50 py-24 md:py-32">
    <div class="container-x">
      <SectionHeading eyebrow="Distanțe" title="Cât aveți de mers" />
      <div class="mt-16 grid gap-16 lg:grid-cols-2 lg:gap-20">
        <div>
          <h3 class="flex items-center gap-3 font-serif text-2xl text-thermal-900" data-reveal>
            <MapPin size={20} stroke-width={1.4} class="text-copper-600" /> În stațiune
          </h3>
          <ul class="mt-8 divide-y divide-thermal-900/10 border-y border-thermal-900/10">
            {
              nearby.map((n, i) => (
                <li class="flex items-baseline justify-between gap-6 py-4" data-reveal data-delay={i * 0.03}>
                  <span class="font-serif text-[1.25rem] text-thermal-900">{n.name}</span>
                  <span class="text-sm font-semibold uppercase tracking-[0.14em] text-copper-600">{n.dist}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="flex items-center gap-3 font-serif text-2xl text-thermal-900" data-reveal>
            <TrainFront size={20} stroke-width={1.4} class="text-copper-600" /> Cum ajungeți
          </h3>
          <ul class="mt-8 divide-y divide-thermal-900/10 border-y border-thermal-900/10">
            {
              transport.map((t, i) => (
                <li class="flex items-baseline justify-between gap-6 py-4" data-reveal data-delay={i * 0.03}>
                  <span class="font-serif text-[1.25rem] text-thermal-900">{t.name}</span>
                  <span class="text-sm font-semibold uppercase tracking-[0.14em] text-copper-600">{t.dist}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-6 text-sm text-muted" data-reveal>
            Distanțele sunt estimative, calculate pe jos sau cu mașina.
          </p>
        </div>
      </div>

      <div class="mt-20" data-reveal>
        <MapEmbed />
      </div>
    </div>
  </section>

  <CTASection image={photo('imprejurimi/04')} />
</BaseLayout>
