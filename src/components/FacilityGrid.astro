---
import { facilities } from '../data/facilities';

interface Props {
  limit?: number;
  dark?: boolean;
  cols?: 3 | 4;
}

const { limit, dark = false, cols = 4 } = Astro.props;
const items = limit ? facilities.slice(0, limit) : facilities;
---

<ul
  class:list={[
    'grid gap-px overflow-hidden rounded-[1.75rem] sm:grid-cols-2',
    cols === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3',
    dark ? 'bg-travertine-100/10' : 'bg-thermal-900/10',
  ]}
>
  {
    items.map((f, i) => (
      <li
        class:list={[
          'group relative p-7 transition-colors duration-500 md:p-9',
          dark ? 'bg-thermal-900 hover:bg-thermal-800' : 'bg-travertine-100 hover:bg-travertine-50',
        ]}
        data-reveal
        data-delay={(i % cols) * 0.06}
      >
        <span
          class:list={[
            'flex h-14 w-14 items-center justify-center rounded-full border transition-all duration-500 group-hover:-translate-y-1',
            dark
              ? 'border-travertine-100/15 text-copper-300 group-hover:border-copper-400'
              : 'border-thermal-900/15 text-thermal-700 group-hover:border-copper-500 group-hover:text-copper-600',
          ]}
        >
          <f.icon size={24} stroke-width={1.3} />
        </span>
        <h3 class:list={['mt-7 font-serif text-[1.4rem] leading-tight', dark ? 'text-travertine-50' : 'text-thermal-900']}>
          {f.title}
        </h3>
        <p class:list={['mt-3 text-[0.93rem] leading-relaxed', dark ? 'text-travertine-100/70' : 'text-muted']}>{f.text}</p>
      </li>
    ))
  }
</ul>
