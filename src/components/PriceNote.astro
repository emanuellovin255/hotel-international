---
import { CalendarCheck } from '@lucide/astro';
import BookingCTA from './BookingCTA.astro';
import { site } from '../data/site';

/**
 * Explicația, o singură dată pe pagină, a locului în care se văd tarifele.
 * Site-ul păstrează descrierile și pozele; prețurile stau în programul hotelului.
 */
interface Props {
  dark?: boolean;
  class?: string;
}

const { dark = false, class: className = '' } = Astro.props;
---

<div
  class:list={[
    'flex flex-col gap-7 rounded-[1.75rem] border p-8 md:p-10 lg:flex-row lg:items-center lg:justify-between',
    dark ? 'border-travertine-100/15 bg-thermal-800 text-travertine-50' : 'border-thermal-900/12 bg-travertine-50',
    className,
  ]}
  data-reveal
>
  <div class="flex gap-5">
    <span
      class:list={[
        'flex h-14 w-14 shrink-0 items-center justify-center rounded-full border',
        dark ? 'border-copper-400/40 text-copper-300' : 'border-copper-500/30 text-copper-600',
      ]}
    >
      <CalendarCheck size={24} stroke-width={1.3} />
    </span>
    <div>
      <h3 class:list={['font-serif text-[1.5rem] leading-tight', dark ? 'text-travertine-50' : 'text-thermal-900']}>
        Tarifele stau într-un singur loc
      </h3>
      <p class:list={['mt-3 max-w-xl text-[0.95rem] leading-relaxed', dark ? 'text-travertine-100/75' : 'text-muted']}>
        În site găsiți descrierile, pozele și informațiile despre hotel. Prețurile și camerele libere le ține
        programul de rezervări al recepției, ca să fie mereu la zi. Alegeți perioada și le vedeți pe toate
        deodată. Preferați să vorbiți cu cineva? {site.phone}.
      </p>
    </div>
  </div>
  <BookingCTA variant={dark ? 'copper' : 'dark'} class="shrink-0" />
</div>
