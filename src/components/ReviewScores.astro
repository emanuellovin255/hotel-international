---
import { ArrowUpRight } from '@lucide/astro';
import { score, categories, reviews } from '../data/reviews';
import { site } from '../data/site';

// Lățimile barelor ca clase statice — Tailwind nu vede clasele construite dinamic.
const barWidth: Record<string, string> = {
  '9,4': 'w-[94%]',
  '9,1': 'w-[91%]',
  '9,0': 'w-[90%]',
  '8,9': 'w-[89%]',
  '8,8': 'w-[88%]',
  '8,5': 'w-[85%]',
};
---

<section class="relative overflow-hidden bg-travertine-50 py-28 md:py-40">
  <div class="container-x">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>Ce spun oaspeții</p>
        <div class="mt-8 flex items-end gap-5" data-reveal>
          <span
            class="font-serif text-[clamp(6rem,14vw,11rem)] leading-[0.8] tracking-[-0.05em] text-thermal-800"
            data-count="8.7"
            data-decimals="1"
          >
            {score.value}
          </span>
          <span class="pb-3">
            <span class="block font-serif text-3xl italic text-copper-600">{score.label}</span>
            <span class="mt-1 block text-sm text-muted">{score.count} evaluări pe Booking.com</span>
          </span>
        </div>

        <ul class="mt-12 space-y-5" data-reveal>
          {
            categories.map((c) => (
              <li>
                <div class="flex items-baseline justify-between text-sm">
                  <span class="font-semibold text-thermal-800">{c.name}</span>
                  <span class="font-serif text-lg">{c.value}</span>
                </div>
                <div class="mt-2 h-[3px] overflow-hidden rounded-full bg-thermal-900/10">
                  <div
                    class:list={['h-full rounded-full bg-gradient-to-r from-mineral-500 to-copper-400', barWidth[c.value] ?? 'w-full']}
                    data-bar
                  />
                </div>
              </li>
            ))
          }
        </ul>

        <a
          href={site.bookingComUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="arrow-link mt-10 text-thermal-800"
          data-reveal
        >
          Toate evaluările pe Booking.com <ArrowUpRight size={16} />
        </a>
      </div>

      <div class="flex flex-col gap-6 lg:col-span-7 lg:pl-8">
        {
          reviews.slice(0, 3).map((r, i) => (
            <figure
              class:list={[
                'relative rounded-[1.75rem] border border-thermal-900/10 bg-travertine-100 p-8 md:p-10',
                i === 1 && 'lg:ml-16',
                i === 2 && 'lg:ml-8',
              ]}
              data-reveal
              data-delay={i * 0.08}
            >
              <svg viewBox="0 0 48 36" class="h-8 w-10 text-copper-400" fill="currentColor" aria-hidden="true">
                <path d="M0 36V21.6C0 9.6 6.4 2.4 19.2 0l2.2 4.6C14.6 6.6 11 10.4 10.6 16H19v20H0Zm27 0V21.6C27 9.6 33.4 2.4 46.2 0l1.8 4.6C41.6 6.6 38 10.4 37.6 16H46v20H27Z" />
              </svg>
              <blockquote class="mt-6 font-serif text-[clamp(1.3rem,2vw,1.7rem)] leading-[1.35] text-thermal-900">
                „{r.text}”
              </blockquote>
              <figcaption class="mt-8 flex items-center gap-4">
                <span class="flex h-11 w-11 items-center justify-center rounded-full bg-thermal-800 font-serif text-lg text-travertine-50">
                  {r.name.charAt(0)}
                </span>
                <span>
                  <span class="block font-semibold">{r.name}</span>
                  <span class="block text-xs uppercase tracking-[0.16em] text-muted">România · via Booking.com</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>
