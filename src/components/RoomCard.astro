---
import { Image } from 'astro:assets';
import { Users, BedDouble, ArrowUpRight } from '@lucide/astro';
import type { Room } from '../data/rooms';
import { photos } from '../lib/photos';
import { url } from '../lib/url';
import { bookingLabel } from '../data/site';

interface Props {
  room: Room;
  index: number;
  class?: string;
}

const { room, index, class: className = '' } = Astro.props;
const cover = photos(room.folder)[0];
---

<!--
  Poza și textul stau în aceeași celulă de grid, nu suprapuse absolut:
  dacă textul se rupe pe mai multe rânduri, cardul crește, nu se încalecă.
-->
<a
  href={url(`/camere/${room.slug}`)}
  class:list={['room-card group relative grid overflow-hidden rounded-[1.75rem] bg-thermal-900 text-white', className]}
>
  <div class="col-start-1 row-start-1 overflow-hidden">
    <Image
      src={cover}
      alt={room.name}
      widths={[480, 720, 960]}
      sizes="(min-width: 1024px) 26vw, (min-width: 640px) 46vw, 88vw"
      class="img-cover transition-transform duration-[1.6s] ease-[var(--ease-out-expo)] group-hover:scale-[1.06]"
    />
  </div>

  <div
    class="pointer-events-none col-start-1 row-start-1 bg-gradient-to-t from-thermal-950 from-5% via-thermal-950/80 via-45% to-thermal-950/5"
  >
  </div>

  <div class="col-start-1 row-start-1 flex min-h-[27rem] flex-col justify-between gap-8 p-6 md:p-7">
    <div class="flex items-start justify-between gap-3">
      <span
        class="rounded-full border border-white/25 bg-white/10 px-3.5 py-1.5 text-[0.62rem] font-semibold uppercase tracking-[0.14em] backdrop-blur-md"
      >
        {room.highlight}
      </span>
      <span class="font-serif text-sm italic text-white/70">{String(index + 1).padStart(2, '0')}</span>
    </div>

    <div>
      <h3 class="font-serif text-[1.7rem] leading-[1.1]">{room.name}</h3>
      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-[0.78rem] text-white/75">
        <span class="inline-flex items-center gap-1.5"><Users size={15} stroke-width={1.6} /> până la {room.guests} pers.</span>
        <span class="inline-flex items-center gap-1.5"><BedDouble size={15} stroke-width={1.6} /> {room.bedShort}</span>
      </div>
      <div class="mt-5 flex items-end justify-between gap-4 border-t border-white/15 pt-5">
        <p class="text-[0.66rem] uppercase tracking-[0.16em] text-white/70">
          Tarif
          <span class="mt-1.5 block font-serif text-[1.1rem] normal-case tracking-normal text-copper-300">
            în programul de rezervări
          </span>
        </p>
        <span
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-white/30 transition-all duration-500 group-hover:rotate-45 group-hover:border-copper-400 group-hover:bg-copper-400 group-hover:text-thermal-900"
          aria-hidden="true"
        >
          <ArrowUpRight size={20} stroke-width={1.6} />
        </span>
      </div>
    </div>
  </div>
  <span class="sr-only">{bookingLabel}</span>
</a>
