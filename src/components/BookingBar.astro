---
import { ArrowUpRight } from '@lucide/astro';
import { bookingEngine, bookingLabel } from '../data/site';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<!--
  Bara de rezervare. Trimite direct în programul de rezervări al hotelului,
  cu perioada aleasă deja completată (parametrul `perioada`, în formatul cerut
  de motor). Site-ul nu calculează și nu afișează niciun preț.
-->
<form
  action={bookingEngine}
  method="get"
  target="_blank"
  rel="noopener noreferrer"
  data-booking-bar
  class:list={[
    'booking-bar grid w-full grid-cols-2 overflow-hidden rounded-[1.5rem] border border-white/15 bg-thermal-950/45 text-white backdrop-blur-xl md:grid-cols-[1fr_1fr_auto] md:rounded-full',
    className,
  ]}
>
  <input type="hidden" name="noframe" value="0" />
  <input type="hidden" name="perioada" data-perioada />

  <label for="bar-sosire" class="bar-field border-b border-r border-white/10 md:border-b-0">
    <span>Sosire</span>
    <input id="bar-sosire" type="date" required aria-label="Data sosirii" data-date-in />
  </label>
  <label for="bar-plecare" class="bar-field border-b border-white/10 md:border-b-0 md:border-r">
    <span>Plecare</span>
    <input id="bar-plecare" type="date" required aria-label="Data plecării" data-date-out />
  </label>
  <div class="col-span-2 p-2 md:col-span-1">
    <button type="submit" class="btn btn-copper h-full w-full md:!px-8">
      {bookingLabel}
      <ArrowUpRight size={16} stroke-width={2} />
    </button>
  </div>
</form>

<style>
  .bar-field {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 1.5rem;
    cursor: pointer;
  }
  @media (min-width: 768px) {
    .bar-field {
      padding: 0.85rem 1.75rem;
    }
  }
  .bar-field span {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.6);
  }
  .bar-field input {
    background: transparent;
    border: 0;
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    color-scheme: dark;
    padding: 0;
    width: 100%;
    appearance: none;
  }
  .bar-field input:focus {
    outline: none;
  }
  .bar-field:focus-within {
    background: rgb(255 255 255 / 0.06);
  }
</style>

<script>
  import { wireDates } from '../scripts/dates';

  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const engineDate = (iso: string) => {
    const [y, m, d] = iso.split('-').map(Number);
    return `${d} ${MONTHS[m - 1]} ${y}`;
  };

  document.querySelectorAll<HTMLFormElement>('[data-booking-bar]').forEach((form) => {
    wireDates(form);
    form.addEventListener('submit', () => {
      const from = form.querySelector<HTMLInputElement>('[data-date-in]')?.value;
      const to = form.querySelector<HTMLInputElement>('[data-date-out]')?.value;
      const field = form.querySelector<HTMLInputElement>('[data-perioada]');
      if (field && from && to) field.value = `${engineDate(from)} - ${engineDate(to)}`;
    });
  });
</script>
