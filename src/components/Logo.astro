---
import { url } from '../lib/url';

interface Props {
  class?: string;
  compact?: boolean;
  id?: string;
}

const { class: className = '', compact = false, id = 'logo' } = Astro.props;
---

<a
  href={url('/')}
  class:list={['group inline-flex items-center gap-3', className]}
  aria-label="Hotel Internațional – pagina principală"
>
  <svg
    viewBox="0 0 40 40"
    class="h-10 w-10 shrink-0 transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:rotate-[-8deg]"
    fill="none"
    aria-hidden="true"
  >
    <circle cx="20" cy="20" r="19" stroke="currentColor" stroke-opacity="0.4" />
    <!-- Cele trei stele ale hotelului -->
    <g fill="var(--color-copper-400)">
      <path d={`M13 11.2 13.7 12.9 15.5 13 14.1 14.1 14.6 15.9 13 14.9 11.4 15.9 11.9 14.1 10.5 13 12.3 12.9Z`} />
      <path d={`M20 9.4 20.8 11.4 23 11.5 21.3 12.8 21.9 14.9 20 13.7 18.1 14.9 18.7 12.8 17 11.5 19.2 11.4Z`} />
      <path d={`M27 11.2 27.7 12.9 29.5 13 28.1 14.1 28.6 15.9 27 14.9 25.4 15.9 25.9 14.1 24.5 13 26.3 12.9Z`} />
    </g>
    <!-- Izvorul: trei unde de apă -->
    <path
      d="M9 22.2c2.9 0 2.9 2.2 5.8 2.2s2.9-2.2 5.8-2.2 2.9 2.2 5.8 2.2 2.9-2.2 5.8-2.2"
      stroke="var(--color-mineral-400)"
      stroke-width="1.5"
      stroke-linecap="round"
    />
    <path
      d="M11 27.2c2.4 0 2.4 2 4.8 2s2.4-2 4.8-2 2.4 2 4.8 2 2.4-2 4.8-2"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-linecap="round"
      stroke-opacity="0.55"
    />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-serif text-[1.35rem] tracking-[-0.015em]">
      Hotel <span class="italic-serif">Internațional</span>
    </span>
    {
      !compact && (
        <span class="mt-1.5 text-[0.54rem] font-semibold uppercase tracking-[0.34em] opacity-70">
          Băile Herculane · din 2010
        </span>
      )
    }
  </span>
</a>
